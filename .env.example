# ==============================================================
# TovarkaDuck Mini App — приклад змінних середовища
# Скопіюйте цей файл у ".env" (для Next.js) і заповніть реальними
# значеннями. НІКОЛИ не комітьте .env у git та не вставляйте
# токени напряму в код.
#
# ⚠️ ДІЯ ПОТРІБНА ЗАРАЗ: у попередній версії цього файлу в публічному
# репозиторії були значення, що виглядають як РЕАЛЬНІ TELEGRAM_BOT_TOKEN
# та пароль DATABASE_URL. Якщо це справжні креденшали — негайно:
#   1) відклич і перевипусти токен бота через @BotFather;
#   2) зміни пароль користувача PostgreSQL;
#   3) переконайся, що нові значення існують ТІЛЬКИ у Vercel
#      Environment Variables / локальному .env, і ніколи більше
#      не потрапляють у git.
# ==============================================================

# --- PostgreSQL / Prisma -----------------------------------------
# Рядок підключення до вашої PostgreSQL бази
DATABASE_URL=""

# --- Telegram Bot -------------------------------------------------
# Токен бота, отриманий від @BotFather
TELEGRAM_BOT_TOKEN=""

# Юзернейм бота (без @), який відкриває Mini App
TELEGRAM_BOT_USERNAME=""

# Chat ID адміністратора (або групи адмінів), куди бот надсилає
# сповіщення про нові замовлення. Дізнатись можна через @userinfobot
TELEGRAM_ADMIN_CHAT_ID=""

# Секретний токен для перевірки вебхука бота (bot/ сервіс)
TELEGRAM_WEBHOOK_SECRET=""

# --- JWT ------------------------------------------------------------
# Секрет для підпису JWT токенів адмін-панелі (мінімум 32 символи)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- Admin credentials (перший вхід / seed) --------------------------
ADMIN_LOGIN=""
ADMIN_PASSWORD=""

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_APP_NAME="TovarkaDuck"

# --- Bot service (окремий Express-сервіс у /bot) ------------------------
BOT_SERVICE_PORT=4000
# URL самого Mini App API (Next.js), який bot-сервіс викликає
MINIAPP_API_URL="http://localhost:3000"
# Внутрішній ключ для авторизації запитів bot-сервісу до Next.js API
INTERNAL_API_SECRET=""

# --- Ручна оплата переказом на картку (checkout) -------------------------
# Це НЕ секретні дані — реквізити показуються кожному покупцю на екрані
# оплати, тому змінні публічні (префікс NEXT_PUBLIC_) і безпечно бачити
# їх у клієнтському коді. Секретів платіжного провайдера тут немає,
# оскільки використовується ручний переказ, а не API еквайрингу.

# Номер картки одержувача, показується покупцю в checkout
NEXT_PUBLIC_CARD_TRANSFER_NUMBER=""

# ПІБ або назва одержувача, показується під номером картки
NEXT_PUBLIC_CARD_TRANSFER_HOLDER=""

# Сума фіксованої передоплати в грн для варіанту "Передоплата ...".
# ВАЖЛИВО: сервер (src/app/api/orders/route.ts) також читає цю змінну
# для розрахунку суми — саме сервер, а не клієнт, вирішує скільки
# покупець мав переказати. Клієнтське значення використовується лише
# для відображення тексту кнопки до відправки форми.
NEXT_PUBLIC_CARD_TRANSFER_PREPAYMENT_AMOUNT="150"
